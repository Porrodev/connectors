{
    "name": "porro/filament-connector",
    "description": "Porro connector for Filament: Filament, Livewire and plugin versions plus panel checks, on top of the Laravel connector.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": ["porro", "filament", "laravel", "monitoring"],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "self.version",
        "filament/filament": "^3.2|^4.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Filament\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Porro\\Filament\\FilamentConnectorServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
