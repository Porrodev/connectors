{
    "name": "porro/statamic-connector",
    "description": "Porro connector for Statamic: Statamic and addon versions plus settings, on top of the Laravel connector.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://porro.dev",
    "keywords": ["porro", "statamic", "laravel", "monitoring"],
    "require": {
        "php": "^8.2",
        "porro/laravel-connector": "self.version",
        "statamic/cms": "^5.0|^6.0"
    },
    "autoload": {
        "psr-4": {
            "Porro\\Statamic\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": ["Porro\\Statamic\\StatamicConnectorServiceProvider"]
        }
    },
    "minimum-stability": "stable"
}
